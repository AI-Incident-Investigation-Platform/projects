[service]
port = 8003

[auth]
jwks_url = "http://auth.apps:8001/.well-known/jwks.json"
allowed_origins = ["http://localhost", "https://localhost"]

[logging]
level = "INFO"
slow_request_ms = 1000

[database]
postgres_host = "postgres"
postgres_port = 5432
postgres_db = "projects"
postgres_username = "projects"
postgres_password = "change-me"

[cache]
host = "dragonfly"
port = 6379
password = "change-me"
db = 0
key_prefix = "projects:"

[tracing]
otlp_endpoint = "http://alloy.infra:4318"

[rabbitmq]
url = "amqp://projects:change-me@rabbitmq.infra:5672/aiip"
